# ─────────────────────────────────────────────
# Trello API Credentials
# ─────────────────────────────────────────────
# 1. Go to: https://trello.com/power-ups/admin
# 2. Create a Power-Up → copy the API Key
# 3. Generate a token:
#    https://trello.com/1/authorize?expiration=never&scope=read,write&response_type=token&key=YOUR_KEY
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ─────────────────────────────────────────────

TRELLO_API_KEY=your_32_char_api_key_here
TRELLO_API_TOKEN=your_64_char_api_token_here
